//we have gien a array/ vector called nums and a given number called k. 
#include <iostream>
#include <vector>
#include<climits>
using namespace std;

int main() {
    vector<int> nums = {2,5,7,7,10};
    int k = 14;

    int l = 0, r = 0;
    int sum = 0;
    int maxlen = 0;
    int n = nums.size();

    while (r < n) {

        sum += nums[r];

        while (sum > k) {
            sum -= nums[l];
            l++;
        }

        if (sum <= k) {
            maxlen = max(maxlen, r - l + 1);
            r++;
        }

        
    }

    cout << maxlen;
}
